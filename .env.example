# Development sample only; production rejects sample mode.
APP_DATA_MODE=sample
# For a prepared local database, use APP_DATA_MODE=database instead.
# DATABASE_URL=postgresql://user:password@localhost:5432/neighborhood
# Match the browser address. Production must use the canonical HTTPS origin.
APP_ORIGIN=http://localhost:3000
# Test commands require a separate disposable *_test database.
# DB_TEST_URL=postgresql://user:password@localhost:5432/neighborhood_test
# Never commit .env.local or real credentials.
